# Aiven PostgreSQL Configuration
DB_HOST=your-aiven-host-here.aivencloud.com
DB_PORT=16852
DB_NAME=defaultdb
DB_USER=avnadmin
DB_PASSWORD=your-aiven-password-here

# Server Configuration
NODE_ENV=development
PORT=5000
CORS_ORIGIN=http://localhost:3000

# Security
SESSION_SECRET=generate-random-key-with-openssl

# Optional
DEBUG=true
